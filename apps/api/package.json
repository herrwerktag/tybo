{
	"name": "@tybo/api",
	"version": "1.0.0",
	"description": "HTTP interface over the stored texts, kept in Postgres",
	"license": "ISC",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "tsx --env-file-if-exists=../../.env src/index.ts",
		"dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
		"typecheck": "tsc --noEmit",
		"test": "tsx --env-file-if-exists=../../.env --test --test-concurrency 1 src/*.test.ts",
		"build": "tsc --noEmit"
	},
	"dependencies": {
		"@tybo/core": "workspace:*",
		"postgres": "^3.4.5"
	},
	"devDependencies": {
		"@types/node": "^26.6.3",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
