      "css": ".ds-board{background-color:var(--surface-inset, #f6f6f6);background-image:radial-gradient(circle,var(--border-strong, #999) 1px,transparent 1px);background-size:24px 24px;padding:2rem}.ds-card{width:16rem;background:var(--surface, #fff);border:1px solid var(--border-strong, #999);border-radius:var(--radius-md, 6px);box-shadow:var(--shadow-sm, 0 2px 6px rgb(0 0 0 / .08));overflow:hidden;color:var(--text, #1a1a1a)}.ds-card:focus-visible{outline:2px solid var(--focus, #3b6fe0);outline-offset:2px;box-shadow:0 0 0 6px rgb(59 111 224 / .18)}.ds-card header{box-shadow:0 1px 0 var(--border, #d4d4d4)}.ds-bar{display:flex;justify-content:space-between;align-items:center;height:23px;padding-left:.5rem;font-size:.8125rem;color:rgb(0 0 0 / .8);box-shadow:var(--tint-shade, none)}.ds-bar button{border:none;background:transparent;padding:0 .35rem;opacity:0;cursor:pointer;color:inherit}.ds-card:hover .ds-bar button,.ds-card:focus-within .ds-bar button{opacity:1}.ds-bar button:hover{background:rgb(0 0 0 / .08)}.ds-name{padding:12px .5rem 11px;line-height:24px;font-weight:600}.ds-props{padding:12px .5rem;display:grid;justify-items:start}.ds-chip{margin:2px 0;padding:0 .4rem;border-radius:var(--radius-sm, 4px);font-size:.8125rem;line-height:20px;background:var(--chip, #ebebeb);color:rgb(0 0 0 / .8);max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}"
