    {
      "name": "Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Standardbutton: Papier, kräftige Haarlinie, Hover auf Tischfilz.",
      "html": "<button class=\"ds-btn\">Abbrechen</button>",
      "css": ".ds-btn{font:inherit;font-size:1rem;line-height:1.25;color:var(--text, #1a1a1a);background:var(--surface, #fff);border:1px solid var(--border-strong, #999);border-radius:var(--radius-sm, 4px);padding:var(--control-padding-y, 0.375rem) 0.75rem;cursor:pointer}.ds-btn:hover{background:var(--surface-inset, #f6f6f6)}.ds-btn:focus-visible{outline:2px solid var(--focus, #3b6fe0);outline-offset:1px}.ds-btn:disabled{opacity:.4;cursor:not-allowed}"
    },
    {
