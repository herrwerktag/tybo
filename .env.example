# Vorlage fuer die lokale .env: kopieren mit `cp .env.example .env` und die echten Werte eintragen.
# Die .env bleibt aus Git heraus (.gitignore); nur diese Vorlage wird eingecheckt.

# Produktive Datenbank: nur der API-Server nutzt sie (pnpm --filter @tybo/api start).
DATABASE_URL=postgres://user:password@host:5432/tybo

# Lokale SQLite-Datei statt Postgres (optional, hat Vorrang vor DATABASE_URL), z. B. local.sqlite.
# LOCAL_DB_PATH=

# Testdatenbank: nur die Tests nutzen sie (pnpm test) — sie schreiben und loeschen dort.
# Leer oder nicht gesetzt: die Datenbank-Tests werden uebersprungen.
TEST_DATABASE_URL=postgres://user:password@host:5432/tybo_test

# Port des API-Servers (optional).
# PORT=3001
